<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración genérica (cualquier Android TV).
  Para un modelo concreto, no edites este archivo: usa perfiles/<nombre>/
  y arranca instalar.ps1 -Perfil <nombre>
-->
<resources>

    <!-- Dock: se omiten las que no estén instaladas. El usuario puede cambiarlas con el mando. -->
    <string-array name="dock_apps">
        <item>com.google.android.youtube.tv</item>
        <item>com.android.vending</item>
    </string-array>

    <!-- No aparecen como mosaico (asistente de primer arranque, etc.). -->
    <string-array name="hidden_apps">
        <item>com.google.android.tungsten.setupwraith</item>
    </string-array>

    <!-- App de sintonizador / Live TV. Vacío = no se ofrece en Entradas. -->
    <string name="live_tv_package" translatable="false"></string>

    <integer name="columns">4</integer>

    <!-- Minutos en segundo plano antes de cerrar una app de usuario. 0 = no cerrar. -->
    <integer name="idle_kill_minutes">10</integer>
</resources>
